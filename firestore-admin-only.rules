// ExpensePlus — OPTIONAL rules for AFTER retiring every old direct-Firestore client.
// Firebase Admin SDK calls from your Express backend bypass these client rules.
// WARNING: Publishing these rules while Spendly v3 is still in use WILL break it.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
