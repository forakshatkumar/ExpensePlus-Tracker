# Server-only values. Never put Admin credentials in VITE_ variables.
CLIENT_ORIGIN=http://localhost:5173
FIREBASE_PROJECT_ID=your-firebase-project-id
# Local development: path to an UNTRACKED service account JSON
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/private/service-account.json
# On Vercel set FIREBASE_SERVICE_ACCOUNT_JSON privately instead of the local path.
# VAPID keys are only needed when enabling web push notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_CONTACT_EMAIL=
