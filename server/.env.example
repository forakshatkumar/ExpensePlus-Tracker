# Local development; do not put Firebase private keys in the repository.
PORT=4000
FIREBASE_PROJECT_ID=spendly-ba3b0
APP_TIME_ZONE=Asia/Kolkata
CLIENT_ORIGIN=http://localhost:5173
# For local only, set GOOGLE_APPLICATION_CREDENTIALS to the absolute path
# of your PRIVATE service-account JSON file (outside the repository).
# For Vercel, add FIREBASE_SERVICE_ACCOUNT_JSON as a private/secret project
# environment variable containing the entire JSON service account.
# Optional: only needed to read or delete avatars previously saved in Firebase Storage.
# New device uploads use Firestore and do not require this variable.
FIREBASE_STORAGE_BUCKET=spendly-ba3b0.firebasestorage.app
# Optional standard Web Push (generate via `npx web-push generate-vapid-keys`):
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_CONTACT_EMAIL=
